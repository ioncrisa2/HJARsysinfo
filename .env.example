APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

PEMBANDING_SCORING_MODE=v2
PEMBANDING_SCORING_TELEMETRY=true
PEMBANDING_SCORING_TELEMETRY_SAMPLE_RATE=1
PEMBANDING_SCORING_LOG_LEVEL=info
PEMBANDING_SCORING_LOG_DAYS=14

SYSTEM_BACKUP_SIGNING_KEY=
SYSTEM_BACKUP_RESTORE_ENABLED=false
SYSTEM_BACKUP_DATABASE_RESTORE_ENABLED=false
SYSTEM_BACKUP_MAX_PACKAGE_MB=1024
SYSTEM_BACKUP_RETENTION_DAYS=30
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Production must explicitly add the real frontend origin/domain to these lists.
# CORS origins include the scheme; Sanctum stateful domains do not.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:3000,127.0.0.1,127.0.0.1:5173

SESSION_DRIVER=database
# With the database driver, deploy migrations before serving requests so that
# the `sessions` table exists and is writable through the selected connection.
# SESSION_CONNECTION=mysql
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Temporary docs access: use a random 8-12 digit PIN; empty restores local/gate access.
API_DOCS_PIN=
API_DOCS_SESSION_MINUTES=60
